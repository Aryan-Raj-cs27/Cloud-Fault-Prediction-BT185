# =============================================================================
# BT-185 FaultAware — what must NEVER be committed
# Everything here is either secret, large, machine-specific or regenerable
# with `make reproduce` / `scripts/package_artifacts.py`.
# =============================================================================

# ---- Secrets & credentials --------------------------------------------------
# scrypt account file (scripts/create_user.py)
secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# ---- Data (raw HDFS logs are 1.5 GB; see data/README and scripts/download_data.py)
data/*
!data/.gitkeep
!data/README.md

# ---- Trained models, run records, release bundles ---------------------------
# weights + predictions (ship via GitHub Release, not git)
models/
# per-run JSON records
runs/
# scripts/package_artifacts.py output
release/
# derived from the raw dataset
app/demo_samples.json
# large per-tick trace (included in the release bundle)
reports/simulation_replay.json

# ---- Logs ---------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---- Frontend -----------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Editors & OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- AI-assistant instructions kept local (team decision) ----------------------
# Docs (guide, report, experiment log) are versioned; only CLAUDE.md stays local.
/CLAUDE.md
